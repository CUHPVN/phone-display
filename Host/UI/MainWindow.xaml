<Window x:Class="PhoneDisplay.Host.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PhoneDisplay"
        Width="900"
        Height="700"
        MinWidth="740"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#090B10"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#141923"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#141923"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#263044"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="#141923" BorderBrush="#263044" BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 4.5 L 9 0 Z" Fill="#94A3B8"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#F8FAFC"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#141923"
                                        BorderBrush="#334155"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#11151E"/>
            <Setter Property="BorderBrush" Value="#1F2636"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SubCard" TargetType="Border">
            <Setter Property="Background" Value="#0D1018"/>
            <Setter Property="BorderBrush" Value="#1D2536"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="KpiTile" TargetType="Border">
            <Setter Property="Background" Value="#151A25"/>
            <Setter Property="BorderBrush" Value="#21293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A2130"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2A354A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#232D42"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161D2B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161C28"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="9,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1F2636" BorderThickness="1" CornerRadius="8" Background="#090B10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#0D1018" BorderBrush="#1A2130" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0" Background="#16A34A">
                            <Path Data="M4,6 H16 V14 H4 Z M8,16 H12" Stroke="#FFFFFF" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Width="20" Height="20"/>
                        </Border>
                        <TextBlock Text="PhoneDisplay" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitleTag" Text="MÀN HÌNH PHỤ KHÔNG DÂY &amp; USB" FontSize="10.5" FontWeight="Medium" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border VerticalAlignment="Center" CornerRadius="6" Padding="10,4"
                                x:Name="StatusBadge" Background="#141923" BorderBrush="#242E42" BorderThickness="1" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatusBadge" Text="Sẵn sàng" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnLangToggle" Style="{StaticResource TitleBarButton}"
                                ToolTip="Switch Language (VI / EN)" Click="BtnLangToggle_Click" Margin="0,0,2,0">
                            <TextBlock x:Name="TxtLangCode" Text="VI" FontSize="11.5" FontWeight="Bold" Foreground="#60A5FA"/>
                        </Button>
                        <Button x:Name="BtnHideToTray" Style="{StaticResource TitleBarButton}"
                                ToolTip="Ẩn xuống khay hệ thống (System Tray)" Click="BtnHideToTray_Click" Margin="0,0,2,0">
                            <TextBlock x:Name="TxtHideToTray" Text="Khay" FontSize="11.5" FontWeight="Medium"/>
                        </Button>
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}" ToolTip="Thu nhỏ" Click="BtnMinimize_Click">
                            <Path Data="M2,7 H10" Stroke="#CBD5E1" StrokeThickness="1.5" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource TitleBarButton}" ToolTip="Đóng (Alt+F4)" Click="BtnClose_Click">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="#CBD5E1" StrokeThickness="1.5" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Workspace: Left Sidebar + Right Tab Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <Border Grid.Column="0" Background="#0C0F16" BorderBrush="#19202E" BorderThickness="0,0,1,0" Padding="12,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Button x:Name="BtnNavStream" Style="{StaticResource NavButton}" Click="BtnNav_Click" Tag="0" Background="#1A2233" Foreground="#FFFFFF" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,3 H14 V11 H2 Z M6,13 H10" Stroke="#22C55E" StrokeThickness="1.5" Width="16" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavStream" Text="Phát hình" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavConnect" Style="{StaticResource NavButton}" Click="BtnNav_Click" Tag="1" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,2 H6 V6 H2 Z M10,2 H14 V6 H10 Z M2,10 H6 V14 H2 Z M10,10 H14 V14 H10 Z" Stroke="#60A5FA" StrokeThickness="1.4" Width="16" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavConnect" Text="Kết nối" FontSize="13" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavSettings" Style="{StaticResource NavButton}" Click="BtnNav_Click" Tag="2" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,2 L13,4 V7.5 C13,10.5 10.8,12.5 8,13.5 C5.2,12.5 3,10.5 3,7.5 V4 Z" Stroke="#94A3B8" StrokeThickness="1.4" Width="16" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavSettings" Text="Cài đặt" FontSize="13" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnNavStatus" Style="{StaticResource NavButton}" Click="BtnNav_Click" Tag="3">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M8,2 A6,6 0 1 1 7.99,2 Z M8,7 V11 M8,4.5 V5" Stroke="#FBBF24" StrokeThickness="1.5" Width="16" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavStatus" Text="Trạng thái" FontSize="13" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Quick PIN Summary in Sidebar -->
                        <Border Grid.Row="2" Style="{StaticResource SubCard}" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="SESSION PIN" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtSidebarPin" Text="------" FontSize="18" FontWeight="Bold" FontFamily="Consolas" Foreground="#4ADE80" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tab Content Area -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="22,18">
                        <!-- TAB 0: STREAM -->
                        <StackPanel x:Name="PageStream" Visibility="Visible">
                            <TextBlock x:Name="TxtStreamTitle" Text="Cấu hình phát hình" FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtStreamSub" Text="Tùy chỉnh luồng truyền Hình ảnh, Âm thanh, Điều khiển, nguồn Cửa sổ và Encoder."
                                       FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,16"/>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <!-- Stream Channels (Live toggleable) -->
                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,14" Padding="12,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock x:Name="TxtChannelsLabel" Text="Luồng truyền (có thể bật/tắt trực tiếp khi đang phát)"
                                                           FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                <Border Background="#14261C" BorderBrush="#1E462E" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="LIVE" FontSize="9.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                                </Border>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="ChkStreamVideo" Grid.Column="0" IsChecked="True" Foreground="#F8FAFC" FontSize="12.5" Cursor="Hand"
                                                          Content="Hình ảnh" Checked="ChkStreamVideo_Changed" Unchecked="ChkStreamVideo_Changed"/>
                                                <CheckBox x:Name="ChkStreamAudio" Grid.Column="1" IsChecked="True" Foreground="#F8FAFC" FontSize="12.5" Cursor="Hand"
                                                          Content="Âm thanh" Checked="ChkStreamAudio_Changed" Unchecked="ChkStreamAudio_Changed"/>
                                                <CheckBox x:Name="ChkAllowInput" Grid.Column="2" IsChecked="True" Foreground="#F8FAFC" FontSize="12.5" Cursor="Hand"
                                                          Content="Điều khiển (Chuột &amp; Phím)" Checked="ChkAllowInput_Changed" Unchecked="ChkAllowInput_Changed"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Video Source Type & Target -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="195"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtVideoSourceTypeLabel" Text="Nguồn phát hình" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CmbVideoSourceType" SelectionChanged="CmbVideoSourceType_SelectionChanged">
                                                <ComboBoxItem x:Name="CmbSrcMonitor" Content="Toàn màn hình (Display)" Tag="monitor" IsSelected="True"/>
                                                <ComboBoxItem x:Name="CmbSrcWindow" Content="Cửa sổ ứng dụng (Window)" Tag="window"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="TxtTargetMonitor" Text="Màn hình mục tiêu" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CmbMonitor" Grid.Column="0" SelectionChanged="CmbVideoTarget_SelectionChanged"/>
                                                <ComboBox x:Name="CmbWindow" Grid.Column="0" Visibility="Collapsed" SelectionChanged="CmbVideoTarget_SelectionChanged"/>
                                                <Button x:Name="BtnRefreshMonitors" Grid.Column="2" Content="Làm mới"
                                                        Style="{StaticResource SecondaryButton}" Height="36" Click="BtnRefreshMonitors_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Audio Output Device -->
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock x:Name="TxtAudioDeviceLabel" Text="Thiết bị âm thanh nguồn (Loa / Tai nghe)" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CmbAudioDevice" SelectionChanged="CmbAudioDevice_SelectionChanged"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="TxtFpsLabel" Text="Tần số quét (FPS)" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CmbFps">
                                                <ComboBoxItem x:Name="CmbFps60" Content="60 FPS (Khuyên dùng)" Tag="60" IsSelected="True"/>
                                                <ComboBoxItem x:Name="CmbFps90" Content="90 FPS" Tag="90"/>
                                                <ComboBoxItem x:Name="CmbFps120" Content="120 FPS (Cáp USB)" Tag="120"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="TxtBitrateLabel" Text="Chất lượng (Bitrate)" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="CmbBitrate">
                                                <ComboBoxItem x:Name="CmbBr8" Content="8 Mbps (Nhẹ)" Tag="8000"/>
                                                <ComboBoxItem x:Name="CmbBr12" Content="12 Mbps (Cân bằng)" Tag="12000" IsSelected="True"/>
                                                <ComboBoxItem x:Name="CmbBr20" Content="20 Mbps (Nét)" Tag="20000"/>
                                                <ComboBoxItem x:Name="CmbBr30" Content="30 Mbps (Tối đa)" Tag="30000"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="TxtEncoderLabel" Text="Bộ mã hóa Video (Encoder)" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbEncoder" Margin="0,0,0,16">
                                        <ComboBoxItem x:Name="CmbEncAuto" Content="Tự động (NVENC RTX → x264)" Tag="auto" IsSelected="True"/>
                                        <ComboBoxItem x:Name="CmbEncNvenc" Content="NVIDIA NVENC (Phần cứng RTX)" Tag="nvenc"/>
                                        <ComboBoxItem x:Name="CmbEncX264" Content="CPU libx264" Tag="x264"/>
                                    </ComboBox>

                                    <TextBlock x:Name="TxtErrorBanner" Text="" Foreground="#F87171" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

                                    <Button x:Name="BtnToggleStream" Height="44" FontSize="14.5" FontWeight="SemiBold"
                                            Foreground="#FFFFFF" Background="#16A34A" BorderThickness="0" Cursor="Hand"
                                            Content="Bắt đầu phát (Start)" Click="BtnToggleStream_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 1: CONNECT -->
                        <StackPanel x:Name="PageConnect" Visibility="Collapsed">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TxtConnectTitle" Text="Kết nối thiết bị" FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock x:Name="TxtConnectSub" Text="Quét mã QR qua Wi-Fi hoặc dùng cáp USB. Mọi kết nối đều yêu cầu mã PIN phiên."
                                               FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#14261C" BorderBrush="#1E462E" BorderThickness="1" CornerRadius="7" Padding="10,6" Margin="0,0,8,0">
                                        <TextBlock x:Name="TxtAccessPin" Text="PIN: ------" FontSize="12.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#4ADE80"/>
                                    </Border>
                                    <Button x:Name="BtnRotatePin" Content="Đổi PIN" Style="{StaticResource SecondaryButton}" Click="BtnRotatePin_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Wi-Fi QR -->
                                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtWifiTitle" Text="Wi-Fi LAN (Quét QR bằng Chrome)" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="iOS: BETA" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                            </Border>
                                        </StackPanel>

                                        <Border Background="#FFFFFF" CornerRadius="8" Padding="8" HorizontalAlignment="Center" Margin="0,6,0,10">
                                            <Image x:Name="ImgQrCode" Width="136" Height="136" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtLanUrl" Text="https://192.168.1.11:8443" IsReadOnly="True"
                                                     Height="34" VerticalContentAlignment="Center"
                                                     Background="#141923" Foreground="#FBBF24" BorderThickness="0"
                                                     Padding="10,0" FontFamily="Consolas" FontSize="11.5"/>
                                            <Button x:Name="BtnCopyLan" Grid.Column="2" Content="Copy" Style="{StaticResource SecondaryButton}" Click="BtnCopyLan_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="TxtWifiHint" Text="Lần đầu qua Wi-Fi: bấm Nâng cao → Tiếp tục truy cập"
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- USB + Radmin -->
                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtUsbTitle" Text="Cáp USB (Độ trễ thấp nhất)" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            <TextBlock x:Name="TxtUsbStatus" Text="Đang kiểm tra ADB..." FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                            <Border Background="#FFFFFF" CornerRadius="6" Padding="6" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <Image x:Name="ImgUsbQrCode" Width="96" Height="96" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtUsbUrl" Text="http://localhost:8080" IsReadOnly="True"
                                                         Height="34" VerticalContentAlignment="Center"
                                                         Background="#141923" Foreground="#60A5FA" BorderThickness="0"
                                                         Padding="10,0" FontFamily="Consolas" FontSize="11.5"/>
                                                <Button x:Name="BtnCopyUsb" Grid.Column="2" Content="Copy" Style="{StaticResource SecondaryButton}" Click="BtnCopyUsb_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock x:Name="TxtRadminTitle" Text="PC ↔ PC qua Radmin / VPN" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="BETA" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtRadminHint" Text="Chưa phát hiện mạng Radmin VPN / Tailscale đang bật."
                                                       FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                            <Grid x:Name="PanelRadmin" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtVpnUrl" Text="" IsReadOnly="True"
                                                         Height="34" VerticalContentAlignment="Center"
                                                         Background="#141923" Foreground="#C4B5FD" BorderThickness="0"
                                                         Padding="10,0" FontFamily="Consolas" FontSize="11.5"/>
                                                <Button x:Name="BtnCopyVpn" Grid.Column="2" Content="Copy" Style="{StaticResource SecondaryButton}" Click="BtnCopyVpn_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- TAB 2: SETTINGS -->
                        <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                            <TextBlock x:Name="TxtSettingsTitle" Text="Cài đặt &amp; Tường lửa" FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtSettingsSub" Text="Quản lý cổng Firewall cho LAN/Radmin, độ phân giải tự động và hành vi khay hệ thống."
                                       FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,16"/>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TxtFwSection" Text="Tường lửa Windows (Chỉ mở cổng HTTPS 8443)" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                    <TextBlock x:Name="TxtFwDesc" Text="Chỉ mở cổng HTTPS/WSS 8443 có mã hóa khi dùng Wi-Fi LAN hoặc Radmin VPN. Cổng USB 8080 được khóa riêng trên 127.0.0.1."
                                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnFirewallOpen" Content="Mở Firewall (8443)" Style="{StaticResource SecondaryButton}"
                                                Background="#14261C" BorderBrush="#1E462E" Foreground="#4ADE80" Click="BtnFirewallOpen_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnFirewallClose" Content="Khóa lại Firewall" Style="{StaticResource SecondaryButton}"
                                                Click="BtnFirewallClose_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox x:Name="ChkAutoRes" IsChecked="True" Foreground="#E2E8F0" FontSize="12.5" Cursor="Hand"
                                                  Content="Tự khớp độ phân giải màn hình phụ theo điện thoại"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="BETA" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                        </Border>
                                    </StackPanel>

                                    <CheckBox x:Name="ChkMinimizeToTrayOnClose" IsChecked="True" Foreground="#CBD5E1" FontSize="12.5" Cursor="Hand"
                                              Content="Ẩn xuống System Tray khi bấm đóng (X)"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtLangSection" Text="Ngôn ngữ giao diện (Language)" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnSettingsLang" Grid.Column="1" Content="Tiếng Việt (VI) ↔ English (EN)" Style="{StaticResource SecondaryButton}" Click="BtnLangToggle_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: FEATURE STATUS & KNOWN NOTES -->
                        <StackPanel x:Name="PageStatus" Visibility="Collapsed">
                            <TextBlock x:Name="TxtStatusTitle" Text="Trạng thái tính năng &amp; Giới hạn" FontSize="19" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="TxtStatusSub" Text="Các tính năng gắn nhãn BETA hoặc có giới hạn nền tảng được liệt kê rõ để bạn dễ theo dõi."
                                       FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,16"/>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#14261C" BorderBrush="#1E462E" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="STABLE" FontSize="10" FontWeight="Bold" Foreground="#4ADE80"/>
                                        </Border>
                                        <TextBlock x:Name="TxtStatusRow1" Grid.Column="2" Text="DXGI + NVENC H.264 Stream, Window Capture, WASAPI Audio, Live Channel Toggle, USB ADB / Tethering, Wi-Fi Android Chrome, View Only / Trackpad / Touch, PC &amp; Mobile Keyboard"
                                                   FontSize="12.5" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#2A2010" BorderBrush="#78350F" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                                        </Border>
                                        <TextBlock x:Name="TxtStatusRow2" Grid.Column="2" Text="Tự khớp độ phân giải màn hình phụ: Phụ thuộc danh sách mode của Virtual Display Driver (VDD); nếu không có tỉ lệ khớp có thể chọn độ phân giải khác."
                                                   FontSize="12.5" Foreground="#CBD5E1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#2A2010" BorderBrush="#78350F" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                                        </Border>
                                        <TextBlock x:Name="TxtStatusRow3" Grid.Column="2" Text="PC ↔ PC qua Radmin VPN: Cần bấm Mở Firewall (8080/8443) trên máy Host; độ mượt phụ thuộc đường truyền VPN."
                                                   FontSize="12.5" Foreground="#CBD5E1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#2A2010" BorderBrush="#78350F" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
                                        </Border>
                                        <TextBlock x:Name="TxtStatusRow4" Grid.Column="2" Text="iOS Safari (16.4+): Cần chấp nhận chứng chỉ HTTPS tự ký thủ công; không hỗ trợ tự Fullscreen / khóa xoay ngang hoặc ADB USB như Android."
                                                   FontSize="12.5" Foreground="#CBD5E1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Non-intrusive Animated Action Feedback Toast -->
                <Border x:Name="ToastBanner" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,22,16" Padding="15,10" CornerRadius="8"
                        Background="#112A1D" BorderBrush="#22C55E" BorderThickness="1.5"
                        RenderTransformOrigin="0.5,0.5"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.65"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ToastScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="ToastTranslate" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="#4ADE80" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtToastMessage" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Persistent Bottom Telemetry KPI Bar -->
            <Border Grid.Row="2" Background="#0C0F16" BorderBrush="#19202E" BorderThickness="0,1,0,0" Padding="18,10" CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiTile}">
                        <StackPanel>
                            <TextBlock Text="FPS" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="StatFps" Text="-- / 60" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KpiTile}">
                        <StackPanel>
                            <TextBlock Text="ENCODE" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="StatEncMs" Text="-- ms" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource KpiTile}">
                        <StackPanel>
                            <TextBlock Text="BITRATE" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="StatBitrate" Text="-- Mbps" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource KpiTile}">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatClientsLabel" Text="THIẾT BỊ" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="StatClients" Text="0 kết nối" FontSize="14.5" FontWeight="Bold" Foreground="#4ADE80" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Style="{StaticResource KpiTile}">
                        <StackPanel>
                            <TextBlock Text="ENCODER" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="StatEncoder" Text="Chưa chạy" FontSize="13" FontWeight="SemiBold" Foreground="#60A5FA" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
